# Nome exibido na interface da TV
VITE_APP_NAME=TouchWall

# URL base da API que alimenta o conteúdo interativo
VITE_API_BASE_URL=https://api.exemplo.com

# URL do provedor de tiles do mapa (padrão: OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Posição e zoom inicial do mapa
VITE_MAP_DEFAULT_LAT=-23.5505
VITE_MAP_DEFAULT_LNG=-46.6333
VITE_MAP_DEFAULT_ZOOM=12

# Tempo (ms) de inatividade antes de voltar para a tela inicial (kiosk mode)
VITE_IDLE_TIMEOUT_MS=120000
